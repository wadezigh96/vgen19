# Vgen19 configuration. Copy to `.env` and fill in your own keys.
# NEVER commit `.env` or any real API key. Placeholder values only here.
#
# API keys are optional at startup: a missing key only blocks the feature
# that needs it, with a clear error naming the variable (fail-closed).
# See README.md for the full configuration table.

# Delphi API key. Required only when live mode talks to Delphi.
# The documented variable is DELPHI_API_ACCESS_KEY; DELPHI_API_KEY
# works as an alias. The same key authenticates both placements:
# Bearer for evidence calls, X-API-Key for reads.
DELPHI_API_ACCESS_KEY=your-delphi-api-key-here

# Optional separate key for Delphi reads only. When set, reads send
# this key as X-API-Key while evidence calls still use the main key
# as Bearer. The escape hatch for the read placement — see the
# placement note in src/delphi/live.ts and the README.
DELPHI_API_READ_KEY=

# When true, scheduled cycles skip the Delphi credential fetch and
# run without a Delphi key, so the agent falls back to the stub
# adapter (fixture markets, canned receipts). Dry-run/stub cycles
# only; a dry run (VGEN19_DRY_RUN=true) is NOT stub mode.
VGEN19_DELPHI_STUB=false

# Google AI Studio (Gemini) API key. Default model provider (free tier).
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini model IDs. Defaults are the free models Google names for new
# projects (verified 20 Nov 2026); override if a model is retired.
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
GEMINI_STRONG_MODEL=gemini-3.8-flash

# OpenRouter API key. Fallback model provider (free models).
OPENROUTER_API_KEY=your-openrouter-api-key-here

# OpenRouter model IDs. Must be free models (IDs ending in ":free", or
# "openrouter/free"). Defaults verified 20 Nov 2026; free models rotate
# often, so check https://openrouter.ai/collections/free-models if one
# stops working.
OPENROUTER_FAST_MODEL=nvidia/nemotron-3.5-lightning:free
OPENROUTER_STRONG_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Tavily API key. Default search provider (free tier).
TAVILY_API_KEY=your-tavily-api-key-here

# Tavily search endpoint. Default is the verified endpoint
# (https://api.tavily.com/search, verified 20 Nov 2026); override only
# if Tavily moves it.
TAVILY_SEARCH_ENDPOINT=https://api.tavily.com/search

# Directory for long-term JSON storage (markets, submissions, receipts,
# rewards, known facts). Default: ./data
VGEN19_DATA_DIR=./data

# When true, the first submissions wait for human approval before they
# go out. Default: true
VGEN19_APPROVAL_GATE=true

# When true, a mining cycle drafts evidence without submitting anything.
# Default: false
VGEN19_DRY_RUN=false

# Self-review pass threshold for the overall rubric score: a draft needs
# at least this score (0, 1] to be approved. Default: 0.7
VGEN19_REVIEW_PASS_THRESHOLD=0.7

# Maximum markets worked in one mining cycle (positive integer).
# Default: 5.
VGEN19_MAX_MARKETS_PER_CYCLE=

# Maximum submissions sent in one mining cycle (positive integer).
# Default: 5. The per-market cap of 3 submissions always applies.
VGEN19_MAX_SUBMISSIONS_PER_CYCLE=5

# Per-cycle time budget in minutes (positive integer). The runner
# stops picking new markets once the deadline passes and finishes
# normally. Default: 45. The run script's hard `timeout` (60 minutes)
# sits above it as a backstop.
VGEN19_CYCLE_TIME_BUDGET_MINUTES=45

# Maximum model calls allowed in one mining cycle (positive integer).
# Default: 50, which matches OpenRouter's free daily allowance for an
# account with no credit purchases.
VGEN19_MODEL_CALL_BUDGET=50

# Research bounds per market (positive integers). Unset means the
# researcher's defaults apply: 3 searches, 5 pages read, 6 model calls
# (extraction plus compaction), and an 8000-character notes budget.
VGEN19_MAX_SEARCHES_PER_MARKET=
VGEN19_MAX_PAGES_PER_MARKET=
VGEN19_MAX_MODEL_CALLS_PER_MARKET=
VGEN19_NOTES_CHAR_BUDGET=
